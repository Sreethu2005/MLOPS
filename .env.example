# PostgreSQL Database settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=hospital_db
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Airflow specific (matching default docker-compose setup)
AIRFLOW_UID=50000

# Data locations
DATA_SOURCE_URL=https://archive.ics.uci.edu/ml/machine-learning-databases/00296/dataset_diabetes.zip
RAW_DATA_PATH=data/raw/input
